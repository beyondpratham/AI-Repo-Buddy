# Copy this file to .env and fill in your values, then load it before
# running the app (e.g. `export $(cat .env | xargs)` or via python-dotenv).
# Without this key, AI Repo Buddy still works but falls back to rule-based
# README parsing and disables the conversational chat.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default Gemini model (see ai_helper.py)
# GEMINI_MODEL=gemini-2.5-flash
